{
  "expo": {
    "name": "이로운사람들",
    "slug": "iroun-benefits",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iroun-benefits",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ko",
        "NSCameraUsageDescription": "지원금 신청 서류를 사진으로 찍어 올릴 때 카메라를 사용해요.",
        "NSPhotoLibraryUsageDescription": "지원금 신청 서류 사진을 골라 올릴 때 사진첩을 사용해요."
      },
      "bundleIdentifier": "com.irounsaram.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundImage": "./assets/images/adaptive-background.png",
        "backgroundColor": "#EAF5FF"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.irounsaram.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0557F0"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain",
      "image": "./assets/images/splash-logo.png"
    },
    "locales": {
      "ko": "./assets/locales/ko.json"
    },
    "owner": "irounsaram",
    "extra": {
      "eas": {
        "projectId": "94cddd49-334b-4118-89b9-6c7937884a44"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
