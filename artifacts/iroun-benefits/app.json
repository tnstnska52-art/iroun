{
  "expo": {
    "name": "이로운사람들",
    "slug": "iroun-benefits",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iroun-benefits",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ko"
      },
      "bundleIdentifier": "com.irounsaram.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0E6DF1"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "package": "com.irounsaram.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "splash": {
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain",
      "image": "./assets/images/icon.png"
    },
    "locales": {
      "ko": "./assets/locales/ko.json"
    },
    "owner": "irounsaram",
    "extra": {
      "eas": {
        "projectId": "94cddd49-334b-4118-89b9-6c7937884a44"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
